# GreenNexa Frontend — Example Environment Variables
# Copy this file to .env.local for local development.
# For production (Vercel), configure in Project Settings -> Environment Variables.

# Backend API Base URL
# Local development: http://127.0.0.1:8001
# Production (Render): https://greennexa-3k2u.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Frontend App URL (for OpenGraph / metadata)
# Production: https://green-nexa.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000