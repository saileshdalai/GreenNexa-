# GreenNexa Backend — Example Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ----- Database -----
DATABASE_URL=postgresql://your_db_user:your_postgres_password@localhost:5432/your_database_name

# SQLite fallback for local testing without PostgreSQL (uncomment to use):
# DATABASE_URL=sqlite:///./greennexa_test.db

# ----- App Settings -----
APP_ENV=development
SECRET_KEY=your_random_secret_key_at_least_32_characters_long
GREENNEXA_DESTRUCTIVE_ACTION_PASSWORD=your_destructive_action_password

# ----- Anomaly Detection Thresholds (configurable) -----
# Probability (0.0–1.0) that a synthetic reading will be an anomaly per cycle
ANOMALY_PROB_ENERGY=0.04
ANOMALY_PROB_WATER=0.03
ANOMALY_PROB_TEMPERATURE=0.05
ANOMALY_PROB_HUMIDITY=0.03

# Minimum number of historical readings required before anomaly detection runs
ANOMALY_MIN_HISTORY=5
GEMINI_API_KEY=your_gemini_api_key

# ----- SMS & OTP Delivery Configuration -----
# Supported SMS_PROVIDER options: 2factor | fast2sms | msg91 | twilio (leave empty for simulation in dev)
SMS_PROVIDER=

# 2Factor Configuration (Official 2Factor.in SMS OTP)
# TWOFACTOR_API_KEY=your_sms_api_key
# TWOFACTOR_OTP_TEMPLATE=your_optional_template_name

# Fast2SMS Configuration (if using Fast2SMS)
FAST2SMS_API_KEY=your_sms_api_key

# MSG91 Configuration (if using MSG91)
MSG91_AUTH_KEY=your_sms_api_key
MSG91_SENDER_ID=GRNNEX
MSG91_TEMPLATE_ID=your_sms_template_id

# Twilio Configuration (if using Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# OTP Security Settings
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5